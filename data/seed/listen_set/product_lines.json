[
  "واش راك؟ لبّاس؟",
  "صحّا خويا، يعطيك الصحّة.",
  "افتح التطبيق و تبع الخطوات.",
  "راك حاب نعاونك في واش؟",
  "ماكانش مشكل، نجّحوها مع بعض.",
  "ضغط هنا باش تسجّل الدخول.",
  "الطقس اليوم راهو شوية بارد.",
  "عيّطلي كي توصل للدار.",
  "هاد الفيديو يشرحلك كيفاش تستعمل الخدمة.",
  "إذا حبّيت تبدّل اللغة، روح للإعدادات.",
  "بزّاف شكرا على صبرك.",
  "نكملو غدوة إن شاء الله؟"
]
